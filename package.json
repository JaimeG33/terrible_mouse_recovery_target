{
  "name": "to-spite-ghislaine-maxwell",
  "version": "0.6.3",
  "private": true,
  "type": "module",
  "description": "Manual-navigation accessibility/recovery helper for supported McGraw Hill EPUB reader books.",
  "scripts": {
    "chrome:start": "powershell -ExecutionPolicy Bypass -File scripts/start-chrome.ps1",
    "chrome:stop": "node src/stop-chrome.mjs",
    "inspect": "node src/inspect.mjs",
    "capture": "node src/capture.mjs",
    "record": "node src/record.mjs",
    "validate": "node src/validate.mjs",
    "chapter:validate": "node src/chapter-health.mjs",
    "toc": "node src/toc.mjs",
    "structure": "node src/structure.mjs",
    "status": "node src/status.mjs",
    "books": "node src/book-manager.mjs list",
    "book:use-current": "node src/book-manager.mjs use-current",
    "runtime:migrate": "node src/migrate-runtime.mjs",
    "runtime:doctor": "node src/runtime-doctor.mjs",
    "assets:inventory": "node src/assets.mjs inventory",
    "assets:download": "node src/assets.mjs download",
    "assets:capture": "node src/assets-capture.mjs",
    "assets:promote": "node src/promote-staged-assets.mjs",
    "assets:validate": "node src/asset-health.mjs",
    "assets:validate:raw": "node src/assets.mjs validate",
    "assemble": "node src/assemble.mjs",
    "pdf": "node src/render-pdf.mjs",
    "proof": "npm run assets:validate && npm run assemble && npm run pdf",
    "security:check": "node src/security-check.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.55.0"
  }
}
